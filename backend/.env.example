# Copy this file to .env and adjust as needed.

# --- Database ---
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=smart_retail
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://retail_admin:change_me_local_only@db:5432/smart_retail

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML thresholds ---
FACE_MATCH_TOLERANCE=0.5
SENTIMENT_MIN_CONFIDENCE=0.55
CHATBOT_MIN_CONFIDENCE=0.35

# --- Optional: Google OAuth (leave blank to keep Google login disabled) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
